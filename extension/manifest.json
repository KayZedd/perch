{
  "manifest_version": 2,
  "name": "Perch: Betterbird Reskin",
  "short_name": "Perch",
  "version": "0.1.0",
  "description": "A warm-paper reskin for Thunderbird and Betterbird with palettes you can edit, plus snooze, one-click unsubscribe, sender initials, attachment preview, account colours and reading typography.",
  "author": "KayZedd",
  "browser_specific_settings": {
    "gecko": { "id": "perch@kayzedd", "strict_min_version": "140.0",
      "strict_max_version": "153.*" }
  },
  "permissions": [
    "storage",
    "alarms",
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesModify",
    "compose",
    "menus"
  ],
  "background": {
    "scripts": ["lib/themes.js", "lib/unsub.js", "lib/snooze.js", "lib/sender.js", "background.js"]
  },
  "message_display_action": {
    "default_title": "Snooze or unsubscribe",
    "default_icon": "icons/snooze.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "experiment_apis": {
    "perch": {
      "schema": "api/perch/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["perch"]],
        "script": "api/perch/implementation.js"
      }
    }
  }
}
